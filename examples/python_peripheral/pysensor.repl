// BlackPill F411 model plus a temperature sensor implemented in Python (IronPython, run by Renode).
// `request` has Type (READ/WRITE), Offset, Value; `self` is the peripheral. Monitor-side control:
// write 0x10 (TEMP_SET, centi-degC) through sysbus, e.g. `sysbus WriteDoubleWord 0x40080010 2500`.
using "../stm32f4_blackpill/blackpill_f411.repl"

pysensor: Python.PythonPeripheral @ sysbus 0x40080000
    size: 0x100
    initable: true
    script: '''
if request.IsInit:
    temp = 2150
    count = 0
elif request.IsRead:
    if request.Offset == 0x0:
        request.Value = 0x5E450001
    elif request.Offset == 0x4:
        request.Value = temp
    elif request.Offset == 0xC:
        request.Value = count
    else:
        request.Value = 0
elif request.IsWrite:
    if request.Offset == 0x8 and request.Value == 1:
        count += 1
    elif request.Offset == 0x10:
        temp = request.Value
        self.InfoLog("temperature set to %d" % temp)
'''
