// @NAME@: a peripheral model written in Python, mapped at 0x40080000 (change the address and the
// `using` line for your platform). Registers: 0x0 ID (RO), 0x4 VALUE (RO), 0x8 CTRL (W: 1 = sample),
// 0xC COUNT (RO), 0x10 VALUE_SET (W, for tests: what VALUE returns next).
using "platforms/cpus/stm32f412.repl"

@NAME@: Python.PythonPeripheral @ sysbus 0x40080000
    size: 0x100
    initable: true
    script: '''
if request.IsInit:
    value = 0
    count = 0
elif request.IsRead:
    if request.Offset == 0x0:
        request.Value = 0x5E450001
    elif request.Offset == 0x4:
        request.Value = value
    elif request.Offset == 0xC:
        request.Value = count
    else:
        self.WarningLog("read from unknown offset 0x%x" % request.Offset)
        request.Value = 0
elif request.IsWrite:
    if request.Offset == 0x8 and request.Value == 1:
        count += 1
    elif request.Offset == 0x10:
        value = request.Value
    else:
        self.WarningLog("write 0x%x to unknown offset 0x%x" % (request.Value, request.Offset))
'''
